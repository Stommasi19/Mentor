{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/adapters/codex/session_start.py\"",
            "timeout": 10,
            "additionalContextLimit": 5000,
            "statusMessage": "Loading Mentor policy and project defaults"
          }
        ]
      }
    ]
  }
}
